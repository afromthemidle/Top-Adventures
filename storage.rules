rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /payment-receipts/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'andres.diaz.alvear@gmail.com');
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
